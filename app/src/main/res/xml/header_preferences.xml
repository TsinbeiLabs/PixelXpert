		android:layout="@layout/settingslib_preference_category_no_title">

		<com.tsinbei.pixelxpert.ui.preferences.preferencesearch.SearchPreference android:key="searchPreference" />

	</PreferenceCategory>

	<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceCategory
