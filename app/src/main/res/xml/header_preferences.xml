		android:title="@string/home_category_personalization"
		app:iconSpaceReserved="false"
		search:ignore="true">

		<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceMain
			android:layout="@layout/custom_preference"
			app:fragment="com.tsinbei.pixelxpert.ui.fragments.LockScreenFragment"
			app:icon="@drawable/ic_settings_lockscreen"
			app:key="lockscreen_header"
			app:summary="@string/lockscreen_header_summary"
			app:title="@string/lockscreen_header_title"
			search:ignore="true" />

		<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceMain
			android:layout="@layout/custom_preference"
			app:fragment="com.tsinbei.pixelxpert.ui.fragments.LauncherFragment"
			app:icon="@drawable/ic_settings_launcher"
			app:key="launcher_header"
			app:summary="@string/launcher_header_summary"
			app:title="@string/launcher_header"
			search:ignore="true" />

		<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceMain
			android:layout="@layout/custom_preference"
			app:fragment="com.tsinbei.pixelxpert.ui.fragments.ThemingFragment"
