		app:iconSpaceReserved="false"
		search:ignore="true">

		<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceMain
			android:layout="@layout/custom_preference"
			app:fragment="com.tsinbei.pixelxpert.ui.fragments.QuickSettingsFragment"
