			android:layout="@layout/custom_preference"
			app:fragment="com.tsinbei.pixelxpert.ui.fragments.PackageManagerFragment"
			app:icon="@drawable/ic_settings_package_manager"
			app:key="pm_header"
			app:summary="@string/pm_header_summary"
			app:title="@string/pm_header"
			search:ignore="true" />

		<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceMain
			android:layout="@layout/custom_preference"
			app:fragment="com.tsinbei.pixelxpert.ui.fragments.MiscFragment"
			app:icon="@drawable/ic_settings_misc"
			app:key="misc_header"
			app:summary="@string/misc_header_summary"
			app:title="@string/misc_header"
			search:ignore="true" />

	</com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceCategory>

