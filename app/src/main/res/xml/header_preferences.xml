			app:key="theming_header"
			app:summary="@string/theme_customization_summary"
			app:title="@string/theme_customization_category"
			search:ignore="true" />

	</com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceCategory>

	<com.tsinbei.pixelxpert.ui.preferences.MaterialPreferenceCategory
